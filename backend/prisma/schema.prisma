generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Customer {
  id        Int        @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  createdAt DateTime   @default(now())
  company   String?
  address   String?
  status    String     @default("Active")
  sales     Sale[]
  followUps FollowUp[]
}

model Lead {
  id        Int        @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  source    String?    @default("Website")
  notes     String?
  status    String     @default("New")
  createdAt DateTime   @default(now())
  followUps FollowUp[]
}

model Sale {
  id            Int       @id @default(autoincrement())
  customerId    Int?
  productName   String
  amount        Float
  status        String    @default("Completed")
  paymentMethod String    @default("Card")
  saleDate      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  customer      Customer? @relation(fields: [customerId], references: [id])
}

model Employee {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  phone      String?
  role       String
  department String?  @default("Sales")
  salary     Float?
  status     String   @default("Active")
  createdAt  DateTime @default(now())
}

model FollowUp {
  id         Int       @id @default(autoincrement())
  customerId Int?
  leadId     Int?
  date       DateTime
  note       String
  status     String    @default("Pending")
  createdAt  DateTime  @default(now())
  customer   Customer? @relation(fields: [customerId], references: [id])
  lead       Lead?     @relation(fields: [leadId], references: [id])
}

model Settings {
  id           Int      @id @default(autoincrement())
  businessName String   @default("Apex Solutions CRM")
  email        String?  @default("contact@apexsolutions.com")
  phone        String?  @default("+91 98765 43210")
  address      String?  @default("Plot 42, Cyber Hub, Bengaluru, India")
  currency     String   @default("₹")
  taxRate      Float    @default(18.0)
  updatedAt    DateTime @updatedAt
}